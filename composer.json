{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "nwidart/laravel-modules": "^13.0",
        "symfony/yaml": "7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Auth\\": "Modules/Auth/app/",
            "Modules\\Auth\\Database\\Seeders\\": "Modules/Auth/database/seeders/",
            "Modules\\Auth\\Database\\Factories\\": "Modules/Auth/database/factories/",
            "Modules\\Category\\": "Modules/Category/app/",
            "Modules\\Category\\Database\\Seeders\\": "Modules/Category/database/seeders/",
            "Modules\\Category\\Database\\Factories\\": "Modules/Category/database/factories/",
            "Modules\\Customers\\": "Modules/Customers/app/",
            "Modules\\Customers\\Database\\Seeders\\": "Modules/Customers/database/seeders/",
            "Modules\\Customers\\Database\\Factories\\": "Modules/Customers/database/factories/",
            "Modules\\Dashboard\\": "Modules/Dashboard/app/",
            "Modules\\Dashboard\\Database\\Seeders\\": "Modules/Dashboard/database/seeders/",
            "Modules\\Dashboard\\Database\\Factories\\": "Modules/Dashboard/database/factories/",
            "Modules\\Discount\\": "Modules/Discount/app/",
            "Modules\\Discount\\Database\\Seeders\\": "Modules/Discount/database/seeders/",
            "Modules\\Discount\\Database\\Factories\\": "Modules/Discount/database/factories/",
            "Modules\\Employee\\": "Modules/Employee/app/",
            "Modules\\Employee\\Database\\Seeders\\": "Modules/Employee/database/seeders/",
            "Modules\\Employee\\Database\\Factories\\": "Modules/Employee/database/factories/",
            "Modules\\Kitchen\\": "Modules/Kitchen/app/",
            "Modules\\Kitchen\\Database\\Seeders\\": "Modules/Kitchen/database/seeders/",
            "Modules\\Kitchen\\Database\\Factories\\": "Modules/Kitchen/database/factories/",
            "Modules\\Order\\": "Modules/Order/app/",
            "Modules\\Order\\Database\\Seeders\\": "Modules/Order/database/seeders/",
            "Modules\\Order\\Database\\Factories\\": "Modules/Order/database/factories/",
            "Modules\\Product\\": "Modules/Product/app/",
            "Modules\\Product\\Database\\Seeders\\": "Modules/Product/database/seeders/",
            "Modules\\Product\\Database\\Factories\\": "Modules/Product/database/factories/",
            "Modules\\Report\\": "Modules/Report/app/",
            "Modules\\Report\\Database\\Seeders\\": "Modules/Report/database/seeders/",
            "Modules\\Report\\Database\\Factories\\": "Modules/Report/database/factories/",
            "Modules\\Restaurant\\": "Modules/Restaurant/app/",
            "Modules\\Restaurant\\Database\\Seeders\\": "Modules/Restaurant/database/seeders/",
            "Modules\\Restaurant\\Database\\Factories\\": "Modules/Restaurant/database/factories/",
            "Modules\\Stock\\": "Modules/Stock/app/",
            "Modules\\Stock\\Database\\Seeders\\": "Modules/Stock/database/seeders/",
            "Modules\\Stock\\Database\\Factories\\": "Modules/Stock/database/factories/",
            "Modules\\User\\": "Modules/User/app/",
            "Modules\\User\\Database\\Seeders\\": "Modules/User/database/seeders/",
            "Modules\\User\\Database\\Factories\\": "Modules/User/database/factories/",
            "Modules\\Waiter\\": "Modules/Waiter/app/",
            "Modules\\Waiter\\Database\\Seeders\\": "Modules/Waiter/database/seeders/",
            "Modules\\Waiter\\Database\\Factories\\": "Modules/Waiter/database/factories/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "12.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
